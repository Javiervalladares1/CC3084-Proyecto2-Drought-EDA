# --- Datos del reto (pesados, no se versionan) -------------------------------
# Train.csv pesa ~276 MB y Test.csv ~33 MB. Se descargan desde Zindi.
data/raw/*
!data/raw/README.md
data/processed/*
!data/processed/.gitkeep

# --- Entornos virtuales ------------------------------------------------------
.venv
.venv/
venv/
env/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/

# --- Sistema operativo -------------------------------------------------------
.DS_Store
# Archivos de bloqueo que crean Word y PowerPoint al abrir un documento
~$*
._*
.Spotlight-V100
.Trashes

# --- Temporales --------------------------------------------------------------
tmp/
*.log

# --- Carpeta de entrega ------------------------------------------------------
# Se reconstruye con scripts/preparar_entrega.py; versionarla duplicaria todo.
repo/

# --- Modelos entrenados y entrega de resultados -----------------------------
# Los manifiestos y métricas se versionan; los pesos se reproducen con el script.
models/
entrega_parte2/
*.zip

# Recursos de ejecución distribuidos en el ZIP local
outputs/modelado/*.parquet
outputs/modelado/submission_*.csv
# Versión intermedia reemplazada por la presentación final verificada
output/presentacion/Proyecto2_Resultados_TWS.pptx
.chart-data-*/
